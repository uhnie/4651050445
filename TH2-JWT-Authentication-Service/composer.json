{
    "name": "student/th2-jwt-authentication-service",
    "type": "project",
    "description": "TH2 - Router, Middleware va bao mat JWT trong RESTful API",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^13.0",
        "php-open-source-saver/jwt-auth": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^12.5",
        "laravel/pint": "^1.24"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
